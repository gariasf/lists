# Offline skill bundle. Same URL, content regenerated each deploy.
# Browser caches for 1h (worst-case staleness = next deploy);
# shared CDN holds 1 day. Edge already serves >99% of requests
# from cache on Pages, but this nails it down explicitly.
/claude-skill/*
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: noindex
  Cross-Origin-Resource-Policy: same-origin

# Static API outputs. Cache modestly; rebuilds with each deploy.
# Next static export emits extensionless files, which Pages would
# otherwise serve as application/octet-stream.
/api/lists/*
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/json; charset=utf-8

# Later rules override earlier ones for the same header, so the
# plain-text and CSV variants get their real types back.
/api/lists/*.txt
  Content-Type: text/plain; charset=utf-8

/api/lists/*.csv
  Content-Type: text/csv; charset=utf-8

/api/manifest
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/json; charset=utf-8
